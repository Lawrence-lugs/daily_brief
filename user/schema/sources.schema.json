{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "sources.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "feeds": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "weight", "type", "kind", "fetcher"],
              "properties": {
                "name": { "type": "string" },
                "query": { "type": "string" },
                "subtopic": { "type": "string" },
                "weight": { "type": "number", "minimum": 0 },
                "type": { "type": "string" },
                "limit": { "type": "integer", "minimum": 1 },
                "kind": { "type": "string" },
                                "fetcher": { "type": "string" },
                "default_subtopic": { "type": ["string", "null"] },
                "publication_number": { "type": "string" },
                "publication_title": { "type": "string" },
                "content_type": { "type": "string" },
                "api_key_env": { "type": "string" },
                "lookback_days": { "type": "integer", "minimum": 1, "maximum": 365 },
                "cadence_days": { "type": "integer", "minimum": 1, "maximum": 365, "description": "How often this feed publishes, in days. Freshness is scored in cycles of this length: floor(age_days / cadence_days). Omit for daily feeds (arXiv, news). Use 30 for a monthly journal, 90 for a quarterly one." },
                "max_records": { "type": "integer", "minimum": 1, "maximum": 200 },
                "max_pages": { "type": "integer", "minimum": 1, "maximum": 10 },
                "source_id": { "type": "string" },
                "per_page": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          }
        },
        "rss": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "weight", "type", "kind"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "weight": { "type": "number", "minimum": 0 },
              "type": { "type": "string" },
              "default_subtopic": { "type": ["string", "null"] },
              "kind": { "type": "string" },
              "cadence_days": { "type": "integer", "minimum": 1, "maximum": 365, "description": "How often this feed publishes, in days. Freshness is scored in cycles of this length: floor(age_days / cadence_days). Omit for daily feeds (arXiv, news). Use 30 for a monthly journal, 90 for a quarterly one." }
            }
          }
        }
      }
    }
  }
}
