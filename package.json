{
  "name": "daily-brief",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "1.0.0",
  "description": "Daily Brief — standalone Electron app (no preinstalled Python or Node required)",
  "engines": {
    "node": ">=22.13"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "serve": "node server/index.js",
    "stop": "node server/stop.js",
    "brief": "node scripts/run_brief.js",
    "feedaudit": "node server/stats/cards/audit_feeds.mjs",
    "app": "electron electron/main.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test server/test/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@xenova/transformers": "^2.17.2",
    "bootstrap-icons": "^1.13.2",
    "jedison": "^1.31.1",
    "onnxruntime-common": "^1.30.0",
    "umap-js": "^1.4.0"
  },
  "build": {
    "productName": "Daily Brief",
    "appId": "com.dailybrief.app",
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
