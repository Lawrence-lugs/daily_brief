{
  "name": "daily-brief",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Daily Brief — desktop research-news frontend (Electron window over a localhost Node server)",
  "engines": {
    "node": ">=22.13"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "serve": "node server/index.js",
    "stop": "node server/stop.js",
    "app": "electron electron/main.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test server/test/*.test.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@xenova/transformers": "^2.17.2",
    "bootstrap-icons": "^1.13.2"
  },
  "build": {
    "productName": "Daily Brief",
    "appId": "com.dailybrief.app",
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ]
    }
  }
}
