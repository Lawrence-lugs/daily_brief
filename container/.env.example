# dailydie container environment (gitignored). Copy to .env and fill in real values.
# Required by the brief generator (LLM + fetching):
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Public hostname(s) the app is served on through Traefik (comma-separated). Required for the hosted deployment.
BRIEF_ALLOWED_HOSTS=your.domain.example
