{
  "paper_name": "The Daily Die",
  "edition_dir": "05-for-agents/daily-brief",
  "db_file": "daily_brief.db",
  "debug_dir": "logs",
  "stories_per_desk": 5,
  "reserve_per_desk": 25,
  "max_agent_output_items_per_desk": 5,

  "selection": {
    "epsilon": 0.25,
    "a50_days": 7.0,
    "slope": 1.0,
    "age_floor_days": 0.25,
    "explore_gamma": 0.3,
    "shown_decay": 0.05,
    "rejected_decay": 0.3,
    "archive_after_days": 7.0,
    "skip_exhausted_subtopics": true
  },

  "pool": {
    "max_age_days": 120
  },

  "fetch": {
    "timeout_s": 20,
    "cache_ttl_hours": 6,
    "arxiv_delay_s": 3.1,
    "api_delay_s": 5.0,
    "hn_lookback_days": 45,
    "user_agent": "daily-brief/1.0 (personal Obsidian vault; stdlib urllib)"
  },

  "llm": {
    "models": [
      "nvidia/nemotron-3-ultra-550b-a55b:free",
      "nvidia/nemotron-3-super-120b-a12b:free",
      "nvidia/nemotron-3.5-lightning:free",
      "openrouter/free"
    ],
    "temperature": 0.3,
    "max_tokens": 20000,
    "timeout_s": 150,
    "retries": 2,
    "max_requests_per_run": 24,
    "min_remaining_daily": 3,
    "effort": "high"
  },

  "ranker": {
    "engine": "keyword",
    "perfect_samples_file": "perfect_samples.json",
    "label": "liked_or_saved",
    "features": ["bias", "type", "author", "medoid"],
    "authors": { "head": 3, "tail": 2, "threshold": 5 },
    "interests": { "kappa": 5, "maxLikedDays": 100, "mode": "constrained", "minClusters": 1 },
    "crossFit": { "folds": 5 },
    "model": {
      "name": "bayes_lr", "maxSweeps": 60, "tol": 0.0001,
      "numDefault": { "mean": 0.45, "std": 0.15 },
      "prior": {
        "default": { "prec": 1, "mean": 0 },
        "rules": [
          { "match": "b",    "prec": 0.5, "mean": -2 },
          { "match": "t:",   "prec": 2 },
          { "match": "a:",   "prec": 3 },
          { "match": "n:d1", "prec": 1, "mean": -0.8 },
          { "match": "n:d2", "prec": 2, "mean": -0.2 },
          { "match": "n:d3", "prec": 2 }
        ]
      }
    },
    "sampling": {
      "epsilon": 0.8,
      "halfLifeDays": 30,
      "freshness": {
        "model": "exponential"
      },
      "desks": { "core": "primary", "side": "science" },
      "explore": { "gamma": 0.5, "floor": 0.01 },
      "dedupe": { "hardWindowDays": 2, "t0": 7, "scale": 2 },
      "slots": { "primary": 5, "science": 5, "reserve": 25 }
    }
  }
}
